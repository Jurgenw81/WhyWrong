# Optional: enables structured LLM classification in the backend.
# Never put this value in frontend files or commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Public-demo cost controls (process-local; use an external store at larger scale).
WHYWRONG_RATE_LIMIT=10
WHYWRONG_RATE_WINDOW_SECONDS=60
WHYWRONG_MAX_SESSION_ANALYSES=3
